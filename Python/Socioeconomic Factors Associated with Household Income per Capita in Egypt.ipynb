   "source": [
    "# ============================================================\n",
    "# 1. Find database dynamically\n",
    "# ============================================================\n",
    "\n",
    "database_candidates = []\n",
    "\n",
    "if \"db_path\" in globals():\n",
    "    candidate = Path(db_path)\n",
    "\n",
    "    if candidate.exists():\n",
    "        database_candidates.append(candidate)\n",
    "\n",
    "if \"star_db_path\" in globals():\n",
    "    candidate = Path(star_db_path)\n",
    "\n",
    "    if candidate.exists():\n",
    "        database_candidates.append(candidate)\n",
    "\n",
    "database_candidates.extend(\n",
    "    Path.cwd().glob(\n",
    "        \"egypt_household_2021_star_schema*.db\"\n",
    "    )\n",
    ")\n",
    "\n",
    "database_candidates = list(\n",
    "    {\n",
    "        candidate.resolve(): candidate.resolve()\n",
    "        for candidate in database_candidates\n",
    "        if candidate.exists()\n",
    "    }.values()\n",
    ")\n",
    "\n",
    "if not database_candidates:\n",
    "    raise FileNotFoundError(\n",
    "        \"No star-schema database was found. \"\n",
    "        \"Run the database creation cell first.\"\n",
    "    )\n",
    "\n",
    "DB_PATH = max(\n",
    "    database_candidates,\n",
    "    key=lambda candidate: candidate.stat().st_mtime,\n",
    ")\n",
    "\n",
    "print(\"Using database:\", DB_PATH.name)\n",
    "\n",
    "# ============================================================\n",
    "# 2. Read database schema\n",
    "# ============================================================\n",
    "\n",
    "connection = sqlite3.connect(\n",
    "    f\"file:{DB_PATH}?mode=ro\",\n",
    "    uri=True,\n",
    ")\n",
    "\n",
    "connection.execute(\n",
    "    \"PRAGMA foreign_keys = ON\"\n",
    ")\n",
    "\n",
    "tables = [\n",
    "    row[0]\n",
    "    for row in connection.execute(\n",
    "        \"\"\"\n",
    "        SELECT name\n",
    "        FROM sqlite_master\n",
    "        WHERE type = 'table'\n",
    "          AND name NOT LIKE 'sqlite_%'\n",
    "        ORDER BY name\n",
    "        \"\"\"\n",
    "    ).fetchall()\n",
    "]\n",
    "\n",
    "required_tables = {\n",
    "    \"DIM_LOCATION\",\n",
    "    \"DIM_HOUSEHOLD\",\n",
    "    \"DIM_EDUCATION\",\n",
    "    \"DIM_LIVING_CONDITIONS\",\n",
    "    \"FACT_HOUSEHOLD_PROFILE\",\n",
    "}\n",
    "\n",
    "missing_tables = required_tables - set(tables)\n",
    "\n",
    "if missing_tables:\n",
    "    connection.close()\n",
    "\n",
    "    raise AssertionError(\n",
    "        \"Missing tables: \"\n",
    "        + \", \".join(sorted(missing_tables))\n",
    "    )\n",
    "\n",
    "schema = {}\n",
    "relationships = []\n",
    "\n",
    "for table in tables:\n",
    "    table_info = connection.execute(\n",
    "        f'PRAGMA table_info(\"{table}\")'\n",
    "    ).fetchall()\n",
    "\n",
    "    foreign_keys = connection.execute(\n",
    "        f'PRAGMA foreign_key_list(\"{table}\")'\n",
    "    ).fetchall()\n",
    "\n",
    "    fk_columns = {\n",
    "        foreign_key[3]\n",
    "        for foreign_key in foreign_keys\n",
    "    }\n",
    "\n",
    "    schema[table] = [\n",
    "        {\n",
    "            \"name\": column[1],\n",
    "            \"type\": column[2] or \"TEXT\",\n",
    "            \"pk\": bool(column[5]),\n",
    "            \"fk\": column[1] in fk_columns,\n",
    "        }\n",
    "        for column in table_info\n",
    "    ]\n",
    "\n",
    "    for foreign_key in foreign_keys:\n",
    "        relationships.append(\n",
    "            (\n",
    "                foreign_key[2],\n",
    "                table,\n",
    "                foreign_key[4],\n",
    "                foreign_key[3],\n",
    "            )\n",
    "        )\n",
    "\n",
    "foreign_key_errors = connection.execute(\n",
    "    \"PRAGMA foreign_key_check\"\n",
    ").fetchall()\n",
    "\n",
    "expected_relationships = {\n",
    "    (\n",
    "        \"DIM_LOCATION\",\n",
    "        \"FACT_HOUSEHOLD_PROFILE\",\n",
    "        \"location_key\",\n",
    "        \"location_key\",\n",
    "    ),\n",
    "    (\n",
    "        \"DIM_HOUSEHOLD\",\n",
    "        \"FACT_HOUSEHOLD_PROFILE\",\n",
    "        \"household_key\",\n",
    "        \"household_key\",\n",
    "    ),\n",
    "    (\n",
    "        \"DIM_EDUCATION\",\n",
    "        \"FACT_HOUSEHOLD_PROFILE\",\n",
    "        \"education_key\",\n",
    "        \"education_key\",\n",
    "    ),\n",
    "    (\n",
    "        \"DIM_LIVING_CONDITIONS\",\n",
    "        \"FACT_HOUSEHOLD_PROFILE\",\n",
    "        \"living_conditions_key\",\n",
    "        \"living_conditions_key\",\n",
    "    ),\n",
    "}\n",
    "\n",
    "missing_relationships = (\n",
    "    expected_relationships - set(relationships)\n",
    ")\n",
    "\n",
    "keys_valid = (\n",
    "    len(foreign_key_errors) == 0\n",
    "    and len(missing_relationships) == 0\n",
    ")\n",
    "\n",
    "connection.close()\n",
    "\n",
    "# ============================================================\n",
    "# 3. Preferred column order\n",
    "# ============================================================\n",
    "\n",
    "preferred_columns = {\n",
    "    \"DIM_LOCATION\": [\n",
    "        \"location_key\",\n",
    "        \"region\",\n",
    "        \"area\",\n",
    "        \"urban_rural\",\n",
    "        \"macro_region\",\n",
    "    ],\n",
    "\n",
    "    \"DIM_HOUSEHOLD\": [\n",
    "        \"household_key\",\n",
    "        \"household_id\",\n",
    "        \"household_composition\",\n",
    "        \"head_gender\",\n",
    "        \"head_gender_group\",\n",
    "        \"head_marital_status\",\n",
    "        \"head_employment_status\",\n",
    "        \"income_source\",\n",
    "        \"income_group\",\n",
    "    ],\n",
    "\n",
    "    \"DIM_EDUCATION\": [\n",
    "        \"education_key\",\n",
    "        \"head_education_level\",\n",
    "        \"head_literacy_status\",\n",
    "        \"head_age_group\",\n",
    "    ],\n",
    "\n",
    "    \"DIM_LIVING_CONDITIONS\": [\n",
    "        \"living_conditions_key\",\n",
    "        \"water_facility\",\n",
    "        \"toilet_facility\",\n",
    "        \"toilet_shared\",\n",
    "        \"has_electricity\",\n",
    "        \"cooking_energy_source\",\n",
    "        \"lighting_energy_source\",\n",
    "        \"garbage_disposal_method\",\n",
    "    ],\n",
    "\n",
    "    \"FACT_HOUSEHOLD_PROFILE\": [\n",
    "        \"household_key\",\n",
    "        \"location_key\",\n",
    "        \"education_key\",\n",
    "        \"living_conditions_key\",\n",
    "        \"household_weight\",\n",
    "        \"household_size\",\n",
    "        \"num_earners\",\n",
    "        \"income_per_capita\",\n",
    "        \"expenditure_per_capita\",\n",
    "        \"income_total_disposable\",\n",
    "        \"exp_total\",\n",
    "        \"saving_rate\",\n",
    "    ],\n",
    "}\n",
    "\n",
    "def ordered_columns(table):\n",
    "    actual_columns = [\n",
    "        column[\"name\"]\n",
    "        for column in schema[table]\n",
    "    ]\n",
    "\n",
    "    preferred = preferred_columns.get(\n",
    "        table,\n",
    "        [],\n",
    "    )\n",
    "\n",
    "    result = []\n",
    "\n",
    "    for column_name in preferred + actual_columns:\n",
    "        if (\n",
    "            column_name in actual_columns\n",
    "            and column_name not in result\n",
    "        ):\n",
    "            result.append(column_name)\n",
    "\n",
    "    return result\n",
    "\n",
    "def get_column(table, column_name):\n",
    "    for column in schema[table]:\n",
    "        if column[\"name\"] == column_name:\n",
    "            return column\n",
    "\n",
    "    raise KeyError(\n",
    "        f\"{column_name} was not found in {table}.\"\n",
    "    )\n",
    "\n",
    "# ============================================================\n",
    "# 4. Field HTML\n",
    "# ============================================================\n",
    "\n",
    "def field_html(column):\n",
    "    badge = \"\"\n",
    "\n",
    "    if column[\"pk\"]:\n",
    "        badge = (\n",
    "            \"<span class='key-badge pk'>\"\n",
    "            \"PK\"\n",
    "            \"</span>\"\n",
    "        )\n",
    "\n",
    "    elif column[\"fk\"]:\n",
    "        badge = (\n",
    "            \"<span class='key-badge fk'>\"\n",
    "            \"FK\"\n",
    "            \"</span>\"\n",
    "        )\n",
    "\n",
    "    return f\"\"\"\n",
    "    <div class='schema-field'>\n",
    "\n",
    "        <span class='field-name'>\n",
    "            {html.escape(column[\"name\"])}\n",
    "        </span>\n",
    "\n",
    "        <span class='field-type'>\n",
    "            {html.escape(column[\"type\"])}\n",
    "        </span>\n",
    "\n",
    "        <span class='field-key'>\n",
    "            {badge}\n",
    "        </span>\n",
    "\n",
    "    </div>\n",
    "    \"\"\"\n",
    "\n",
    "# ============================================================\n",
    "# 5. Table card\n",
    "# ============================================================\n",
    "\n",
    "def table_card(\n",
    "    table,\n",
    "    class_name,\n",
    "    visible_limit,\n",
    "):\n",
    "    column_names = ordered_columns(table)\n",
    "\n",
    "    columns = [\n",
    "        get_column(table, column_name)\n",
    "        for column_name in column_names\n",
    "    ]\n",
    "\n",
    "    visible_columns = columns[:visible_limit]\n",
    "    hidden_columns = columns[visible_limit:]\n",
    "\n",
    "    visible_html = \"\".join(\n",
    "        field_html(column)\n",
    "        for column in visible_columns\n",
    "    )\n",
    "\n",
    "    hidden_html = \"\"\n",
    "\n",
    "    if hidden_columns:\n",
    "        hidden_fields_html = \"\".join(\n",
    "            field_html(column)\n",
    "            for column in hidden_columns\n",
    "        )\n",
    "\n",
    "        hidden_html = f\"\"\"\n",
    "        <details class='more-columns'>\n",
    "\n",
    "            <summary>\n",
    "                Show {len(hidden_columns)} more columns\n",
    "            </summary>\n",
    "\n",
    "            <div class='hidden-column-list'>\n",
    "                {hidden_fields_html}\n",
    "            </div>\n",
    "\n",
    "        </details>\n",
    "        \"\"\"\n",
    "\n",
    "    role = (\n",
    "        \"FACT · household grain\"\n",
    "        if table.startswith(\"FACT_\")\n",
    "        else \"DIMENSION\"\n",
    "    )\n",
    "\n",
    "    return f\"\"\"\n",
    "    <section class='schema-card {class_name}'>\n",
    "\n",
    "        <header class='schema-card-header'>\n",
    "\n",
    "            <span class='table-name'>\n",
    "                {html.escape(table)}\n",
    "            </span>\n",
    "\n",
    "            <span class='table-role'>\n",
    "                {html.escape(role)}\n",
    "            </span>\n",
    "\n",
    "        </header>\n",
    "\n",
    "        <div class='schema-card-body'>\n",
    "            {visible_html}\n",
    "            {hidden_html}\n",
    "        </div>\n",
    "\n",
    "    </section>\n",
    "    \"\"\"\n",
    "\n",
    "# ============================================================\n",
    "# 6. Create table cards\n",
    "# ============================================================\n",
    "\n",
    "location_card = table_card(\n",
    "    \"DIM_LOCATION\",\n",
    "    \"location-card\",\n",
    "    visible_limit=5,\n",
    ")\n",
    "\n",
    "education_card = table_card(\n",
    "    \"DIM_EDUCATION\",\n",
    "    \"education-card\",\n",
    "    visible_limit=4,\n",
    ")\n",
    "\n",
    "household_card = table_card(\n",
    "    \"DIM_HOUSEHOLD\",\n",
    "    \"household-card\",\n",
    "    visible_limit=7,\n",
    ")\n",
    "\n",
    "living_card = table_card(\n",
    "    \"DIM_LIVING_CONDITIONS\",\n",
    "    \"living-card\",\n",
    "    visible_limit=8,\n",
    ")\n",
    "\n",
    "# FACT table: one field per row\n",
    "fact_card = table_card(\n",
    "    \"FACT_HOUSEHOLD_PROFILE\",\n",
    "    \"fact-card\",\n",
    "    visible_limit=12,\n",
    ")\n",
    "\n",
    "status_class = (\n",
    "    \"valid\"\n",
    "    if keys_valid\n",
    "    else \"invalid\"\n",
    ")\n",
    "\n",
    "status_text = (\n",
    "    \"PK/FK structure validated successfully\"\n",
    "    if keys_valid\n",
    "    else \"PK/FK structure needs attention\"\n",
    ")\n",
    "\n",
    "# ============================================================\n",
    "# 7. Complete ERD design\n",
    "# ============================================================\n",
    "\n",
    "ERD_HTML = f\"\"\"\n",
    "<style>\n",
    "\n",
    ".hiecs-erd {{\n",
    "    --bg:#070603;\n",
    "    --surface:#100d07;\n",
    "    --gold:#d5b343;\n",
    "    --light-gold:#f3dc89;\n",
    "    --text:#f7efd8;\n",
    "    --muted:#aaa083;\n",
    "    --line:#91782d;\n",
    "    --green:#8dcd72;\n",
    "    --red:#ef8c79;\n",
    "\n",
    "    width:100%;\n",
    "    max-width:1080px;\n",
    "\n",
    "    margin:18px auto;\n",
    "    padding:16px;\n",
    "\n",
    "    box-sizing:border-box;\n",
    "\n",
    "    background:\n",
    "        radial-gradient(\n",
    "            circle at 50% 43%,\n",
    "            rgba(213,179,67,.09),\n",
    "            transparent 33%\n",
    "        ),\n",
    "        linear-gradient(\n",
    "            180deg,\n",
    "            #0b0803,\n",
    "            var(--bg)\n",
    "        );\n",
    "\n",
    "    border:\n",
    "        1px solid rgba(213,179,67,.44);\n",
    "\n",
    "    border-top:\n",
    "        3px solid var(--gold);\n",
    "\n",
    "    border-radius:13px;\n",
    "\n",
    "    color:var(--text);\n",
    "    font-family:Arial, sans-serif;\n",
    "}}\n",
    "\n",
    ".hiecs-erd * {{\n",
    "    box-sizing:border-box;\n",
    "}}\n",
    "\n",
    "/* Header */\n",
    "\n",
    ".erd-topbar {{\n",
    "    display:flex;\n",
    "    align-items:flex-start;\n",
    "    justify-content:space-between;\n",
    "    gap:16px;\n",
    "    margin-bottom:14px;\n",
    "}}\n",
    "\n",
    ".erd-title {{\n",
    "    margin:0;\n",
    "\n",
    "    color:var(--light-gold);\n",
    "\n",
    "    font-family:Georgia, serif;\n",
    "    font-size:23px;\n",
