    "if \"income_per_capita\" not in households.columns:\n",
    "    households[\"income_per_capita\"] = households[\"income_total_disposable\"].div(\n",
    "        households[\"household_size\"].where(households[\"household_size\"].gt(0))\n",
    "    )\n",
    "\n",
    "if \"expenditure_per_capita\" not in households.columns:\n",
