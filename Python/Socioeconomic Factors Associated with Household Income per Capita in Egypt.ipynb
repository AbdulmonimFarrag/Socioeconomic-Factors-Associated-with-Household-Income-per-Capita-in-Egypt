    "\n",
    "    </div>\n",
    "\n",
    "    <div class='erd-canvas'>\n",
    "\n",
    "        <svg\n",
    "            class='erd-connectors'\n",
    "            viewBox='0 0 1000 820'\n",
    "            preserveAspectRatio='none'\n",
    "            aria-hidden='true'\n",
    "        >\n",
    "\n",
