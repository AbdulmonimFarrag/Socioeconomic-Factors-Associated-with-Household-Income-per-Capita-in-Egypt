    "        linear-gradient(\n",
    "            180deg,\n",
    "            rgba(23,17,7,.99),\n",
    "            rgba(12,10,6,.99)\n",
    "        );\n",
    "\n",
    "    border:\n",
    "        1px solid rgba(213,179,67,.58);\n",
    "\n",
    "    border-radius:10px;\n",
    "\n",
    "    box-shadow:\n",
    "        0 13px 30px rgba(0,0,0,.30);\n",
    "}}\n",
    "\n",
    ".schema-card:has(details[open]) {{\n",
    "    z-index:50;\n",
    "}}\n",
    "\n",
    ".schema-card-header {{\n",
    "    display:block;\n",
    "\n",
    "    min-height:48px;\n",
    "    padding:9px 11px;\n",
    "\n",
    "    background:\n",
    "        rgba(213,179,67,.14);\n",
    "\n",
    "    border-bottom:\n",
    "        1px solid rgba(213,179,67,.30);\n",
    "\n",
    "    border-radius:9px 9px 0 0;\n",
    "}}\n",
    "\n",
    "/* Central fact card */\n",
    "\n",
    ".fact-card {{\n",
