    "    if column in households.columns\n",
    "]\n",
    "\n",
    "dim_household = households[[\"household_key\"] + household_dimension_columns].copy()\n",
    "for column in household_dimension_columns:\n",
    "    if column != \"household_id\":\n",
    "        dim_household[column] = dim_household[column].map(text_value)\n",
    "\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "# 4. Prepare one and only one fact table\n",
    "# -----------------------------------------------------------------------------\n",
    "required_measures = [\n",
    "    \"household_weight\",\n",
    "    \"household_size\",\n",
    "    \"income_total_disposable\",\n",
