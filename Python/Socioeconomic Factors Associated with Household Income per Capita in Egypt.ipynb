    "\n",
    "households = households.merge(\n",
    "    living_conditions,\n",
    "    on=living_conditions_columns,\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\",\n",
    ")\n",
    "\n",
    "household_dimension_columns = [\n",
    "    column\n",
    "    for column in [\n",
    "        \"household_id\",\n",
    "        \"household_composition\",\n",
    "        \"head_gender\",\n",
