   "source": [
    "# ============================================================\n",
    "# Main Descriptive Statistics Table\n",
    "# ============================================================\n",
    "\n",
    "desc_data = hh.copy()\n",
    "\n",
    "for column in [\n",
    "    \"income_total_disposable\", \"household_size\", \"num_earners\",\n",
    "    \"num_under_14\", \"num_aged_65_plus\", \"exp_total\", \"exp_total_food\",\n",
    "]:\n",
    "    if column in desc_data.columns:\n",
    "        desc_data[column] = pd.to_numeric(desc_data[column], errors=\"coerce\")\n",
    "\n",
    "if \"income_per_capita\" not in desc_data.columns:\n",
    "    required = [\"income_total_disposable\", \"household_size\"]\n",
    "    missing = [column for column in required if column not in desc_data.columns]\n",
    "    if missing:\n",
    "        raise KeyError(\"Cannot calculate income_per_capita; missing: \" + \", \".join(missing))\n",
    "    valid_size = desc_data[\"household_size\"].where(desc_data[\"household_size\"].gt(0))\n",
    "    desc_data[\"income_per_capita\"] = desc_data[\"income_total_disposable\"].div(valid_size)\n",
    "else:\n",
    "    desc_data[\"income_per_capita\"] = pd.to_numeric(desc_data[\"income_per_capita\"], errors=\"coerce\")\n",
    "\n",
    "if \"expenditure_per_capita\" not in desc_data.columns:\n",
    "    valid_size = desc_data[\"household_size\"].where(desc_data[\"household_size\"].gt(0))\n",
    "    desc_data[\"expenditure_per_capita\"] = desc_data[\"exp_total\"].div(valid_size)\n",
    "\n",
    "room_map = {name: number for number, name in enumerate(\n",
    "    [\"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\", \"Ten\"],\n",
    "    start=1,\n",
    ")}\n",
    "if \"num_rooms\" in desc_data.columns:\n",
    "    numeric_rooms = pd.to_numeric(desc_data[\"num_rooms\"], errors=\"coerce\")\n",
    "    text_rooms = (\n",
    "        desc_data[\"num_rooms\"].astype(\"string\").str.strip().str.split().str[0].str.title().map(room_map)\n",
    "    )\n",
    "    desc_data[\"num_rooms\"] = numeric_rooms.fillna(text_rooms)\n",
    "\n",
    "preferred_columns = [\n",
    "    \"income_per_capita\", \"income_total_disposable\", \"household_size\",\n",
    "    \"num_earners\", \"num_under_14\", \"num_aged_65_plus\", \"num_rooms\",\n",
    "    \"exp_total\", \"exp_total_food\", \"expenditure_per_capita\",\n",
    "]\n",
    "desc_columns = [column for column in preferred_columns if column in desc_data.columns]\n",
    "for column in desc_columns:\n",
    "    desc_data[column] = pd.to_numeric(desc_data[column], errors=\"coerce\")\n",
    "desc_columns = [column for column in desc_columns if desc_data[column].notna().any()]\n",
    "\n",
    "descriptive_stats = (\n",
    "    desc_data[desc_columns].describe().T.rename(columns={\n",
    "        \"count\": \"Count\", \"mean\": \"Mean\", \"std\": \"Standard deviation\",\n",
    "        \"min\": \"Minimum\", \"25%\": \"Q1\", \"50%\": \"Median\",\n",
    "        \"75%\": \"Q3\", \"max\": \"Maximum\",\n",
    "    })\n",
    ")\n",
    "descriptive_stats = descriptive_stats[[\n",
    "    \"Count\", \"Mean\", \"Median\", \"Standard deviation\",\n",
    "    \"Minimum\", \"Maximum\", \"Q1\", \"Q3\",\n",
    "]].round(2)\n",
    "descriptive_stats.index.name = \"Household variable\"\n",
    "display(descriptive_stats)\n"
   ]
  },
