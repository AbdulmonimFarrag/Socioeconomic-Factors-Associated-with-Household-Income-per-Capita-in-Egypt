    ").fetchone()[0]\n",
    "distinct_fact_keys = connection.execute(\n",
    "    \"SELECT COUNT(DISTINCT household_key) FROM FACT_HOUSEHOLD_PROFILE\"\n",
    ").fetchone()[0]\n",
    "connection.close()\n",
    "\n",
    "if fact_tables != [\"FACT_HOUSEHOLD_PROFILE\"]:\n",
    "    raise AssertionError(f\"Expected exactly one fact table; found: {fact_tables}\")\n",
    "if foreign_key_errors:\n",
    "    raise AssertionError(f\"Foreign-key violations: {foreign_key_errors}\")\n",
    "if fact_row_count != len(households) or distinct_fact_keys != fact_row_count:\n",
    "    raise AssertionError(\"The fact table does not preserve one row per household.\")\n",
    "\n",
    "db_path = star_db_path\n",
    "validation_summary = pd.DataFrame({\n",
    "    \"Check\": [\n",
    "        \"Database created\",\n",
    "        \"Exactly one fact table\",\n",
    "        \"Household grain preserved\",\n",
    "        \"Unique fact household keys\",\n",
    "        \"Foreign-key violations\",\n",
    "    ],\n",
    "    \"Result\": [\n",
    "        star_db_path.name,\n",
    "        len(fact_tables),\n",
    "        fact_row_count,\n",
    "        distinct_fact_keys,\n",
    "        len(foreign_key_errors),\n",
    "    ],\n",
    "    \"Expected\": [\"Created\", 1, len(households), fact_row_count, 0],\n",
    "})\n",
    "display(validation_summary)\n",
    "print(\"Star Schema database created successfully.\")\n",
    "print(\"Database:\", star_db_path.resolve())\n",
    "print(\"Fact table: FACT_HOUSEHOLD_PROFILE\")\n",
    "print(\"Fact rows:\", f\"{fact_row_count:,}\")\n",
    "print(\"Measures:\", len(measure_columns))\n",
    "print(\"Foreign-key violations:\", foreign_key_errors)\n"
   ]
  },
