    "detailed_food_columns_to_drop = [\n",
    "    \"Rice expenditures\", \"Grains and flour expenditures\", \"Bread and cakes\",\n",
    "    \"Pasta expenditures\", \"Cereal preparation\", \"Own-Produced Bread and Cereals\",\n",
