    "\n",
    "    </div>\n",
    "\n",
    "</div>\n",
    "\"\"\"\n",
    "\n",
    "display(\n",
    "    HTML(ERD_HTML)\n",
    ")\n",
    "\n",
    "print(\"Database:\", DB_PATH)\n",
    "print(\n",
    "    \"Foreign-key errors:\",\n",
    "    foreign_key_errors,\n",
    ")\n",
