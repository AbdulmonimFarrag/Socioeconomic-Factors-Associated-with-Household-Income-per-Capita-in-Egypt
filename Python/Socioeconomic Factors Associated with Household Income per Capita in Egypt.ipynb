    "    \"\\u0633\\u0628\\u0639 \\u063a\\u0631\\u0641\": \"Seven rooms\", \"\\u062b\\u0645\\u0627\\u0646 \\u063a\\u0631\\u0641\": \"Eight rooms\", \"\\u062a\\u0633\\u0639 \\u063a\\u0631\\u0641\": \"Nine rooms\",\n",
