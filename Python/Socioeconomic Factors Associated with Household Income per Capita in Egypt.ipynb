    "# Preserve the engineered household-level table and validate its grain.\n",
    "if \"hh\" in globals() and isinstance(hh, pd.DataFrame):\n",
    "    hh = hh.copy()\n",
    "    if \"household_id\" not in hh.columns and hh.index.name == \"household_id\":\n",
    "        hh = hh.reset_index()\n",
    "else:\n",
    "    if \"df_merged\" not in globals():\n",
    "        raise NameError(\"Run the cell that creates df_merged first.\")\n",
    "    if \"household_id\" not in df_merged.columns:\n",
    "        raise KeyError(\"household_id is missing from df_merged.\")\n",
    "    hh = (\n",
    "        df_merged\n",
    "        .drop_duplicates(subset=[\"household_id\"], keep=\"first\")\n",
    "        .reset_index(drop=True)\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "if \"household_id\" not in hh.columns:\n",
    "    raise KeyError(\"household_id is missing from the household table.\")\n",
    "\n",
    "hh = (\n",
    "    hh\n",
    "    .drop_duplicates(subset=[\"household_id\"], keep=\"first\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "for column in [\n",
    "    \"household_weight\",\n",
    "    \"household_size\",\n",
    "    \"income_total_disposable\",\n",
    "    \"exp_total\",\n",
    "]:\n",
    "    if column in hh.columns:\n",
    "        hh[column] = pd.to_numeric(hh[column], errors=\"coerce\")\n",
    "\n",
    "required = [\"household_size\", \"income_total_disposable\", \"exp_total\"]\n",
    "missing = [column for column in required if column not in hh.columns]\n",
    "if missing:\n",
    "    raise KeyError(\"Missing household columns: \" + \", \".join(missing))\n",
    "\n",
    "valid_size = hh[\"household_size\"].where(hh[\"household_size\"].gt(0))\n",
    "hh[\"income_per_capita\"] = hh[\"income_total_disposable\"].div(valid_size)\n",
    "hh[\"expenditure_per_capita\"] = hh[\"exp_total\"].div(valid_size)\n",
    "hh[\"saving_rate\"] = (\n",
    "    hh[\"income_total_disposable\"] - hh[\"exp_total\"]\n",
    ").div(hh[\"income_total_disposable\"].where(hh[\"income_total_disposable\"].ne(0)))\n",
    "\n",
    "print(\"Household model-ready table validated.\")\n",
    "print(\"Households:\", f\"{len(hh):,}\")\n",
    "print(\"Unique household IDs:\", f\"{hh['household_id'].nunique():,}\")\n",
    "print(\"Valid income-per-capita values:\", f\"{hh['income_per_capita'].notna().sum():,}\")\n"
   ]
