    "if \"hh\" not in globals():\n",
    "    raise NameError(\"Run the household feature-engineering cells first so 'hh' exists.\")\n",
    "\n",
    "if not isinstance(hh, pd.DataFrame):\n",
    "    raise TypeError(\"'hh' must be a pandas DataFrame.\")\n",
    "\n",
    "\n",
    "def as_household_table(source):\n",
    "    \"\"\"Return one row per household without changing the source DataFrame.\"\"\"\n",
    "    out = source.copy()\n",
    "\n",
    "    if \"household_id\" not in out.columns:\n",
    "        out = out.reset_index()\n",
    "\n",
    "    if \"household_id\" not in out.columns:\n",
    "        raise KeyError(\"'household_id' is required in the household-level table.\")\n",
    "\n",
    "    if out[\"household_id\"].isna().any():\n",
    "        raise ValueError(\"'household_id' contains missing values.\")\n",
    "\n",
    "    if out[\"household_id\"].duplicated().any():\n",
    "        out = out.drop_duplicates(\"household_id\", keep=\"first\")\n",
    "\n",
    "    out = out.reset_index(drop=True)\n",
    "\n",
    "    if not out[\"household_id\"].is_unique:\n",
    "        raise ValueError(\"'household_id' must be unique at the household grain.\")\n",
    "\n",
    "    return out\n",
    "\n",
    "\n",
    "households = as_household_table(hh)\n",
    "\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "# 2. Small helpers for stable dimensions and numeric measures\n",
    "# -----------------------------------------------------------------------------\n",
    "def first_existing(columns, candidates):\n",
    "    return next((column for column in candidates if column in columns), None)\n",
    "\n",
    "\n",
    "def text_value(value, default=\"Not stated\"):\n",
    "    if pd.isna(value):\n",
    "        return default\n",
    "    value = str(value).strip()\n",
    "    return value if value else default\n",
    "\n",
    "\n",
    "def numeric_value(series):\n",
    "    \"\"\"Convert numeric, Boolean, and common yes/no fields to numbers.\"\"\"\n",
    "    if pd.api.types.is_bool_dtype(series):\n",
    "        return series.astype(\"Int64\").astype(float)\n",
    "\n",
    "    if pd.api.types.is_numeric_dtype(series):\n",
    "        return pd.to_numeric(series, errors=\"coerce\")\n",
    "\n",
    "    normalized = series.astype(\"string\").str.strip().str.lower()\n",
    "    boolean_map = {\n",
    "        \"true\": 1,\n",
    "        \"false\": 0,\n",
    "        \"yes\": 1,\n",
    "        \"no\": 0,\n",
    "        \"y\": 1,\n",
    "        \"n\": 0,\n",
    "        \"1\": 1,\n",
    "        \"0\": 0,\n",
    "    }\n",
    "    mapped = normalized.map(boolean_map)\n",
    "    numeric = pd.to_numeric(series, errors=\"coerce\")\n",
    "    return numeric.where(numeric.notna(), mapped)\n",
    "\n",
    "\n",
    "def add_numeric_measure(frame, column, required=False):\n",
    "    if column not in frame.columns:\n",
    "        if required:\n",
    "            raise KeyError(f\"Required measure '{column}' is missing.\")\n",
    "        return False\n",
    "\n",
    "    frame[column] = numeric_value(frame[column])\n",
    "    return True\n",
    "\n",
    "\n",
    "def sql_type_for_dimension(series):\n",
    "    if pd.api.types.is_integer_dtype(series):\n",
    "        return \"INTEGER\"\n",
    "    if pd.api.types.is_float_dtype(series):\n",
    "        return \"REAL\"\n",
    "    return \"TEXT\"\n",
    "\n",
    "\n",
    "def db_value(value):\n",
    "    if pd.isna(value):\n",
    "        return None\n",
    "    if isinstance(value, (np.integer, int)):\n",
    "        return int(value)\n",
    "    if isinstance(value, (np.floating, float)):\n",
    "        return float(value)\n",
    "    if isinstance(value, (np.bool_, bool)):\n",
    "        return int(value)\n",
    "    return str(value)\n",
    "\n",
    "\n",
    "def quote_identifier(identifier):\n",
    "    return '\"' + str(identifier).replace('\"', '\"\"') + '\"'\n",
    "\n",
    "\n",
    "def insert_frame(connection, table_name, frame):\n",
    "    columns = list(frame.columns)\n",
    "    quoted_columns = \", \".join(quote_identifier(column) for column in columns)\n",
    "    placeholders = \", \".join(\"?\" for _ in columns)\n",
    "    rows = [\n",
    "        tuple(db_value(value) for value in row)\n",
    "        for row in frame.itertuples(index=False, name=None)\n",
    "    ]\n",
    "\n",
    "    connection.executemany(\n",
    "        f\"INSERT INTO {quote_identifier(table_name)} ({quoted_columns}) VALUES ({placeholders})\",\n",
    "        rows,\n",
    "    )\n",
    "\n",
    "\n",
    "# -----------------------------------------------------------------------------\n",
    "# 3. Prepare the dimensions\n",
    "# -----------------------------------------------------------------------------\n",
    "households.insert(0, \"household_key\", np.arange(1, len(households) + 1, dtype=int))\n",
    "\n",
    "for column, default in {\n",
    "    \"region\": \"All regions\",\n",
    "    \"area\": \"All areas\",\n",
    "    \"urban_rural\": \"All areas\",\n",
    "    \"macro_region\": \"All regions\",\n",
    "}.items():\n",
    "    if column not in households.columns:\n",
    "        households[column] = default\n",
    "\n",
    "location_columns = [\"region\", \"area\", \"urban_rural\", \"macro_region\"]\n",
    "\n",
    "location_work = households[location_columns].copy()\n",
    "for column in location_columns:\n",
    "    households[column] = households[column].map(text_value)\n",
    "    location_work[column] = households[column]\n",
    "\n",
    "locations = location_work.drop_duplicates().reset_index(drop=True)\n",
    "locations.insert(0, \"location_key\", np.arange(1, len(locations) + 1, dtype=int))\n",
    "\n",
    "households = households.merge(\n",
    "    locations,\n",
    "    on=location_columns,\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\",\n",
    ")\n",
    "\n",
    "for column in [\n",
    "    \"head_education_level\",\n",
    "    \"head_literacy_status\",\n",
    "    \"head_age_group\",\n",
    "]:\n",
    "    if column not in households.columns:\n",
    "        households[column] = \"Not stated\"\n",
    "\n",
    "education_columns = [\n",
    "    \"head_education_level\",\n",
    "    \"head_literacy_status\",\n",
    "    \"head_age_group\",\n",
    "]\n",
    "\n",
    "education_work = households[education_columns].copy()\n",
    "for column in education_columns:\n",
    "    households[column] = households[column].map(text_value)\n",
    "    education_work[column] = households[column]\n",
    "\n",
    "education = education_work.drop_duplicates().reset_index(drop=True)\n",
    "education.insert(0, \"education_key\", np.arange(1, len(education) + 1, dtype=int))\n",
    "\n",
    "households = households.merge(\n",
    "    education,\n",
    "    on=education_columns,\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\",\n",
    ")\n",
    "\n",
    "living_conditions_columns = [\n",
