   "source": [
    "# ============================================================\n",
    "# Weighted Descriptive Statistics\n",
    "# ============================================================\n",
    "\n",
    "weighted_data = hh.copy()\n",
    "if \"household_weight\" not in weighted_data.columns:\n",
    "    raise KeyError(\"household_weight is missing from the household table.\")\n",
    "\n",
    "for column in [\n",
    "    \"household_weight\", \"income_total_disposable\", \"household_size\",\n",
    "    \"num_earners\", \"num_under_14\", \"num_aged_65_plus\",\n",
    "    \"exp_total\", \"exp_total_food\",\n",
    "]:\n",
    "    if column in weighted_data.columns:\n",
    "        weighted_data[column] = pd.to_numeric(weighted_data[column], errors=\"coerce\")\n",
    "\n",
    "if \"income_per_capita\" not in weighted_data.columns:\n",
    "    required = [\"income_total_disposable\", \"household_size\"]\n",
    "    missing = [column for column in required if column not in weighted_data.columns]\n",
    "    if missing:\n",
    "        raise KeyError(\"Cannot calculate income_per_capita; missing: \" + \", \".join(missing))\n",
    "    valid_size = weighted_data[\"household_size\"].where(weighted_data[\"household_size\"].gt(0))\n",
    "    weighted_data[\"income_per_capita\"] = weighted_data[\"income_total_disposable\"].div(valid_size)\n",
    "else:\n",
    "    weighted_data[\"income_per_capita\"] = pd.to_numeric(weighted_data[\"income_per_capita\"], errors=\"coerce\")\n",
    "\n",
    "weighted_numeric_columns = [\n",
    "    column for column in [\n",
    "        \"income_per_capita\", \"income_total_disposable\", \"household_size\",\n",
    "        \"num_earners\", \"num_under_14\", \"num_aged_65_plus\",\n",
    "        \"exp_total\", \"exp_total_food\",\n",
    "    ] if column in weighted_data.columns\n",
    "]\n",
    "\n",
    "room_map = {name: number for number, name in enumerate(\n",
    "    [\"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\", \"Ten\"],\n",
    "    start=1,\n",
    ")}\n",
    "if \"num_rooms\" in weighted_data.columns:\n",
    "    numeric_rooms = pd.to_numeric(weighted_data[\"num_rooms\"], errors=\"coerce\")\n",
    "    text_rooms = (\n",
    "        weighted_data[\"num_rooms\"].astype(\"string\").str.strip().str.split().str[0].str.title().map(room_map)\n",
    "    )\n",
    "    weighted_data[\"num_rooms_numeric\"] = numeric_rooms.fillna(text_rooms)\n",
    "    if weighted_data[\"num_rooms_numeric\"].notna().any():\n",
    "        weighted_numeric_columns.append(\"num_rooms_numeric\")\n",
    "\n",
    "weighted_rows = []\n",
    "for column in weighted_numeric_columns:\n",
    "    weighted_data[column] = pd.to_numeric(weighted_data[column], errors=\"coerce\")\n",
    "    weighted_rows.append({\n",
    "        \"Variable\": column,\n",
    "        \"Valid observations\": weighted_data[column].notna().sum(),\n",
    "        \"Weighted mean\": weighted_mean(weighted_data[column], weighted_data[\"household_weight\"]),\n",
    "        \"Weighted median\": weighted_median(weighted_data[column], weighted_data[\"household_weight\"]),\n",
    "    })\n",
    "\n",
    "weighted_descriptive_stats = pd.DataFrame(weighted_rows).set_index(\"Variable\").round(2)\n",
    "display(weighted_descriptive_stats)\n",
    "\n",
    "for column in [\n",
    "    \"income_group\", \"urban_rural\", \"region\", \"head_education_level\",\n",
    "    \"housing_deprivation\", \"asset_group\", \"size_group\", \"earners_group\",\n",
    "]:\n",
    "    if column in weighted_data.columns:\n",
    "        print(f\"\\nWeighted percentages: {column}\")\n",
    "        display(weighted_percentage_table(weighted_data, column))\n"
   ]
  },
