   "source": [
    "<div style=\"background-color:#0b0905;border:1px solid #2b2410;border-top:2px solid #d4af37;border-radius:6px;padding:14px 22px 12px;margin:26px 0 8px;\"><h2 style=\"margin:0;padding:0;border:0;font-family:Fraunces,Georgia,'Times New Roman',serif;font-size:23px;line-height:1.25;font-weight:700;color:#f3d77a;\">6.2. Merging the Datasets</h2><div style=\"font-family:Manrope,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:1.5;color:#a8a086;font-style:italic;margin-top:5px;\">Left-joins the household columns onto the individuals (many persons to one household).</div></div>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 76,
   "id": "cell-0182",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Merged shape: (50458, 129)\n",
      "Individual columns: 48\n",
      "Household columns added: 81\n"
     ]
    }
   ],
   "source": [
    "# Merge person records with their household information using household ID. Keep all individual\n",
    "# rows by using a left join.\n",
    "df_merged = df_cleaned.merge(\n",
    "    hh_clean.drop(columns=shared_columns),\n",
    "    on=key,\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\",\n",
    ")\n",
    "\n",
    "if len(df_merged) != len(df_cleaned):\n",
    "    raise ValueError(\"The merge changed the number of individuals.\")\n",
    "if not np.array_equal(df_merged[key].to_numpy(), df_cleaned[key].to_numpy()):\n",
    "    raise ValueError(\"The merge changed the order or the keys of the individuals.\")\n",
    "\n",
    "print(f\"Merged shape: {df_merged.shape}\")\n",
    "print(f\"Individual columns: {df_cleaned.shape[1]}\")\n",
    "print(f\"Household columns added: {df_merged.shape[1] - df_cleaned.shape[1]}\")\n"
   ]
  },
