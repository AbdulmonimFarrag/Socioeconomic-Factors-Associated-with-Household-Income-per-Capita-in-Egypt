    "                1 : many\n",
    "            </text>\n",
    "\n",
    "            <text x='655' y='595'>\n",
    "                1 : many\n",
    "            </text>\n",
    "\n",
    "        </svg>\n",
    "\n",
    "        {location_card}\n",
    "\n",
    "        {education_card}\n",
    "\n",
    "        {household_card}\n",
    "\n",
    "        {living_card}\n",
    "\n",
